# Copy to deploy/.env. This file contains configuration only, never secrets.
MOUCHEN_IMAGE=mouchen-backend:private-alpha
MOUCHEN_BIND_PORT=8788
# Existing private-alpha upgrade only: set this to the unchanged historical
# owner id while MOUCHEN_LEGACY_AUTH_ENABLED=true. Fresh installs leave blank.
MOUCHEN_SINGLE_USER_ID=
# Keep false for normal multi-user/commercial operation. Set true only for the
# bounded owner-claim window, then return it to false immediately after the
# owner can authenticate with username and password.
MOUCHEN_LEGACY_AUTH_ENABLED=false
# Give the existing private-alpha tenant a login name without changing its
# stored user id. Keep this JSON on one line. New installations may leave it
# blank until no legacy data exists.
MOUCHEN_LEGACY_USERNAMES_JSON={"replace-with-the-phone-user-id":"owner"}
MOUCHEN_REGISTRATION_MODE=closed
MOUCHEN_ALLOW_OPEN_REGISTRATION=false
MOUCHEN_AUTH_TOKEN_TTL_DAYS=90
# Leave blank unless a known reverse proxy is the direct backend peer.
# Derived and overridden by deploy.sh from the verified mouchen_default bridge
# gateway. Leave blank; the runtime guard rejects broad or mismatched networks.
MOUCHEN_TRUSTED_PROXY_CIDRS=
MOUCHEN_TRUSTED_PROXY_HEADER=x-forwarded-for
MOUCHEN_MAX_REQUEST_BYTES=262144
MOUCHEN_MAX_EVENT_FACTS_BYTES=65536
MOUCHEN_MAX_AUDIO_BYTES=4320000
MOUCHEN_LOGIN_RATE_WINDOW_SECONDS=900
MOUCHEN_LOGIN_ACCOUNT_ATTEMPTS_PER_WINDOW=20
MOUCHEN_LOGIN_SOURCE_ATTEMPTS_PER_WINDOW=120
MOUCHEN_REGISTRATION_RATE_WINDOW_SECONDS=900
MOUCHEN_REGISTRATION_SOURCE_ATTEMPTS_PER_WINDOW=10
MOUCHEN_AUTH_HASH_CONCURRENCY=2
MOUCHEN_AUTHENTICATED_RATE_WINDOW_SECONDS=60
MOUCHEN_AUTHENTICATED_REQUESTS_PER_USER_WINDOW=600
MOUCHEN_AUTHENTICATED_REQUESTS_GLOBAL_WINDOW=5000
MOUCHEN_RATE_LIMITER_MAX_KEYS=50000
MOUCHEN_RATE_LIMITER_MAX_HITS=250000
MOUCHEN_RATE_LIMITER_SWEEP_SECONDS=60
MOUCHEN_EVENT_RATE_WINDOW_SECONDS=60
MOUCHEN_EVENT_INGESTS_PER_WINDOW=240
MOUCHEN_EVENT_STORAGE_BYTES_PER_USER=104857600
MOUCHEN_MAX_GOALS_PER_USER=200
MOUCHEN_MAX_GOAL_TARGET_BYTES=16384
MOUCHEN_MAX_CHARTERS_PER_USER=50
MOUCHEN_MAX_FEEDBACK_PER_USER=10000
MOUCHEN_MAX_GUIDANCE_PER_ADVICE=20
MOUCHEN_DEMO_SEED_ENABLED=false
MOUCHEN_AUTH_FAILURE_RETENTION_HOURS=24
MOUCHEN_AUTH_FAILURE_MAX_ROWS=100000
MOUCHEN_AUTH_ACTIVE_DEVICES_PER_USER=20
MOUCHEN_AUTH_TOKEN_HISTORY_PER_USER=200
MOUCHEN_MAX_DEVICES_PER_USER=50
MOUCHEN_CLOUD_AUDIT_RETENTION_DAYS=30
MOUCHEN_CLOUD_AUDIT_BYTES_PER_USER=20971520

# The base must be HTTPS and include the provider's version prefix.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_STYLE=responses
OPENAI_ROUTINE_MODEL=gpt-5.6-terra
OPENAI_COMPLEX_MODEL=gpt-5.6-sol
OPENAI_SECOND_OPINION_MODEL=gpt-5.6-sol
MOUCHEN_COMMERCIAL_MULTI_USER=true
MOUCHEN_MODEL_MAX_OUTPUT_TOKENS=2048

# Raw context still requires the matching per-request Android approval header.
MOUCHEN_ALLOW_RAW_CLOUD=false
MOUCHEN_ANALYSIS_BACKGROUND_ENABLED=true
MOUCHEN_ANALYSIS_BACKGROUND_BATCH_SIZE=1
MOUCHEN_ANALYSIS_MODEL_CALLS_PER_HOUR=12
MOUCHEN_ANALYSIS_MODEL_CALLS_PER_DAY=60
MOUCHEN_GLOBAL_MODEL_CALLS_PER_HOUR=120
MOUCHEN_GLOBAL_MODEL_CALLS_PER_DAY=600
MOUCHEN_DIRECT_MODEL_RATE_WINDOW_SECONDS=60
MOUCHEN_DIRECT_MODEL_REQUESTS_PER_WINDOW=10
MOUCHEN_DIRECT_MODEL_USER_CONCURRENCY=1
MOUCHEN_DIRECT_MODEL_GLOBAL_CONCURRENCY=4
MOUCHEN_DIRECT_MODEL_LEASE_SECONDS=600
MOUCHEN_LIVE_ANALYSIS_MAX_EVENT_AGE_SECONDS=900

# Private-VPS speech-to-text. A network-isolated, non-root sherpa-onnx
# Paraformer sidecar keeps the checksum-pinned Mandarin model resident.
MOUCHEN_LOCAL_STT_ENABLED=true
MOUCHEN_LOCAL_STT_SERVER_URL=http://stt:8080/inference
MOUCHEN_LOCAL_STT_ENGINE=local-paraformer-sherpa-onnx
MOUCHEN_LOCAL_STT_FFMPEG=/opt/mouchen-stt/bin/ffmpeg
MOUCHEN_LOCAL_STT_MODEL=/opt/mouchen-stt/models/paraformer/model.int8.onnx
MOUCHEN_LOCAL_STT_MODEL_SHA256=f36a0433bcf096bd6d6f11b80a3ac8bed110bdca632fe0d731df8d1a84475945
MOUCHEN_LOCAL_STT_MODEL_SIZE=243371218
MOUCHEN_LOCAL_STT_TIMEOUT_SECONDS=15
MOUCHEN_LOCAL_STT_THREADS=4
# Durable per-account request window and crash-safe concurrency leases. Runtime
# raises a too-short lease to cover upload timeout + inference timeout + margin.
MOUCHEN_STT_RATE_WINDOW_SECONDS=300
MOUCHEN_STT_REQUESTS_PER_WINDOW=10
MOUCHEN_STT_USER_CONCURRENCY=1
MOUCHEN_STT_GLOBAL_CONCURRENCY=2
MOUCHEN_STT_LEASE_SECONDS=60
MOUCHEN_STT_BODY_READ_TIMEOUT_SECONDS=30
# Private 0700/0600 export spools live on the persistent /data volume. Runtime
# cleans expired crash residue and deletes completed downloads.
MOUCHEN_ACCOUNT_EXPORT_TEMP_DIR=/data/.account-exports
MOUCHEN_ACCOUNT_EXPORT_MAX_BYTES=268435456
MOUCHEN_ACCOUNT_EXPORT_COOLDOWN_SECONDS=300
MOUCHEN_ACCOUNT_EXPORT_LEASE_SECONDS=3600
MOUCHEN_ACCOUNT_STEP_UP_ATTEMPTS_PER_WINDOW=5
MOUCHEN_ACCOUNT_STEP_UP_SOURCE_ATTEMPTS_PER_WINDOW=25
MOUCHEN_ACCOUNT_STEP_UP_WINDOW_SECONDS=900
MOUCHEN_BACKEND_MEMORY_LIMIT=768m
MOUCHEN_BACKEND_CPUS=2.0
MOUCHEN_STT_MEMORY_LIMIT=1536m
MOUCHEN_STT_CPUS=4.0
MOUCHEN_STT_BUILD_ARCHIVE_NAME=sherpa-onnx-paraformer-zh-2023-09-14.tar.bz2
MOUCHEN_STT_BUILD_ARCHIVE_SHA256=9c49fd9c6fb63de8e18c1054cf3d100f804741b7e608e187923cd8ff09fa9f03
MOUCHEN_STT_BUILD_ARCHIVE_SIZE=234051698
MOUCHEN_STT_BUILD_MODEL_SHA256=f36a0433bcf096bd6d6f11b80a3ac8bed110bdca632fe0d731df8d1a84475945
MOUCHEN_STT_BUILD_MODEL_SIZE=243371218
MOUCHEN_STT_BUILD_VOCAB_SHA256=59aba8873a2ed1e122c25fee421e25f283b63290efbde85c1f01a853d83cb6e6

# The container baseline has no Claude Code binary. Use an explicit independent
# OpenAI critic on a private deployment, or keep fail-closed with disabled.
MOUCHEN_CLAUDE_REVIEW_PROVIDER=disabled
