# Private configuration and credentials. Only clearly named examples are tracked.
.env
.env.*
!.env.example
*config*.json
!config/*.example.json
*secret*
*credential*
*token*.json
*.key
*.pem
*.pfx
*.p12
*.crt
id_rsa*
id_ed25519*
.ssh/
.aws/

# Local content, archives and application state
data/
state/
blobs/
Archive/
Outbox/
staging/
work/
outputs/
*.db
*.db-*
*.sqlite*
*.receipt.json
status.json
worker.lock
stop-sync
*.log
*.log.*
*.part
.tmp-*

# Python build and development artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Compiled programs and packages
bin/
obj/
*.exe
*.dll
*.pdb
*.zip
*.tar
*.gz
*.7z

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
