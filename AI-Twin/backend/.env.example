MOUCHEN_DB_PATH=./data/mouchen.db
# Required for Android/LAN access. Send Authorization: Bearer <value> on every /v1/* request.
# If unset, only direct loopback requests are accepted.
MOUCHEN_API_TOKEN=
# Docker-style alternative. When MOUCHEN_API_TOKEN is unset, read this file.
MOUCHEN_API_TOKEN_FILE=
# Fail /ready unless an API token can be loaded. Enable for every deployment.
MOUCHEN_REQUIRE_API_TOKEN=false
# Legacy migration binding. Session tokens derive user identity server-side;
# keep this set only while old clients still use the private-alpha token.
MOUCHEN_SINGLE_USER_ID=
# Closed by default. Create ordinary one-time invitations with the server-side
# invite CLI. Keep the bootstrap secret only for the initial legacy-owner claim.
MOUCHEN_REGISTRATION_MODE=closed
MOUCHEN_ALLOW_OPEN_REGISTRATION=false
MOUCHEN_BOOTSTRAP_REGISTRATION_CODE=
MOUCHEN_BOOTSTRAP_REGISTRATION_CODE_FILE=
MOUCHEN_AUTH_TOKEN_TTL_DAYS=90
# Commercial-beta abuse limits. Forwarded/Forwarded-For is ignored unless the
# immediate peer belongs to one of these explicit CIDRs (comma separated).
MOUCHEN_TRUSTED_PROXY_CIDRS=
MOUCHEN_TRUSTED_PROXY_HEADER=x-forwarded-for
MOUCHEN_MAX_REQUEST_BYTES=262144
MOUCHEN_MAX_EVENT_FACTS_BYTES=65536
MOUCHEN_MAX_AUDIO_BYTES=4320000
MOUCHEN_LOGIN_RATE_WINDOW_SECONDS=900
MOUCHEN_LOGIN_ACCOUNT_ATTEMPTS_PER_WINDOW=20
MOUCHEN_LOGIN_SOURCE_ATTEMPTS_PER_WINDOW=120
MOUCHEN_REGISTRATION_RATE_WINDOW_SECONDS=900
MOUCHEN_REGISTRATION_SOURCE_ATTEMPTS_PER_WINDOW=10
MOUCHEN_AUTH_HASH_CONCURRENCY=2
MOUCHEN_AUTHENTICATED_RATE_WINDOW_SECONDS=60
MOUCHEN_AUTHENTICATED_REQUESTS_PER_USER_WINDOW=600
MOUCHEN_AUTHENTICATED_REQUESTS_GLOBAL_WINDOW=5000
MOUCHEN_RATE_LIMITER_MAX_KEYS=50000
MOUCHEN_RATE_LIMITER_MAX_HITS=250000
MOUCHEN_RATE_LIMITER_SWEEP_SECONDS=60
MOUCHEN_EVENT_RATE_WINDOW_SECONDS=60
MOUCHEN_EVENT_INGESTS_PER_WINDOW=240
MOUCHEN_EVENT_STORAGE_BYTES_PER_USER=104857600
MOUCHEN_MAX_GOALS_PER_USER=200
MOUCHEN_MAX_GOAL_TARGET_BYTES=16384
MOUCHEN_MAX_CHARTERS_PER_USER=50
MOUCHEN_MAX_FEEDBACK_PER_USER=10000
MOUCHEN_MAX_GUIDANCE_PER_ADVICE=20
MOUCHEN_DEMO_SEED_ENABLED=false
MOUCHEN_AUTH_FAILURE_RETENTION_HOURS=24
MOUCHEN_AUTH_FAILURE_MAX_ROWS=100000
MOUCHEN_AUTH_ACTIVE_DEVICES_PER_USER=20
MOUCHEN_AUTH_TOKEN_HISTORY_PER_USER=200
MOUCHEN_MAX_DEVICES_PER_USER=50
MOUCHEN_CLOUD_AUDIT_RETENTION_DAYS=30
MOUCHEN_CLOUD_AUDIT_BYTES_PER_USER=20971520
# One-line JSON mapping of unchanged legacy user ids to login names.
MOUCHEN_LEGACY_USERNAMES_JSON=
# Explicit private-test escape hatch; never enable on a publicly reachable listener.
MOUCHEN_ALLOW_UNAUTHENTICATED_PRIVATE_ALPHA=false
# One process-local authorized semantic consumer. Batch size is hard-capped at 10.
MOUCHEN_ANALYSIS_BACKGROUND_ENABLED=true
MOUCHEN_ANALYSIS_BACKGROUND_BATCH_SIZE=1
# Explicit model provider: auto, openai, or codex_cli. Auto prefers a configured
# OpenAI API key; Windows startup selects codex_cli by default.
MOUCHEN_MODEL_PROVIDER=auto
# Commercial servers must not execute tenant prompts inside host Codex/Claude
# agents. They use isolated API/local-model providers only.
MOUCHEN_COMMERCIAL_MULTI_USER=false
# Hard ceiling per provider call; invalid values fall back to 2048 and the
# runtime clamps the setting to 128..8192.
MOUCHEN_MODEL_MAX_OUTPUT_TOKENS=2048
# Rolling limits persist in SQLite across restarts and defer jobs when full.
MOUCHEN_ANALYSIS_MODEL_CALLS_PER_HOUR=12
MOUCHEN_ANALYSIS_MODEL_CALLS_PER_DAY=288
# SQLite-durable global paid-provider fuse shared across tenants and workers.
# Queued reservations and direct calls survive process or container restarts.
MOUCHEN_GLOBAL_MODEL_CALLS_PER_HOUR=120
MOUCHEN_GLOBAL_MODEL_CALLS_PER_DAY=600
# Direct question/API admission is durable in SQLite. Local Ollama calls do
# not spend paid-call budget, but still consume rate and concurrency slots.
MOUCHEN_DIRECT_MODEL_RATE_WINDOW_SECONDS=60
MOUCHEN_DIRECT_MODEL_REQUESTS_PER_WINDOW=10
MOUCHEN_DIRECT_MODEL_USER_CONCURRENCY=1
MOUCHEN_DIRECT_MODEL_GLOBAL_CONCURRENCY=4
MOUCHEN_DIRECT_MODEL_LEASE_SECONDS=600
# Older uploads are stored only. Paid analysis of history must use the explicit
# bounded /v1/analysis/backfill endpoint.
MOUCHEN_LIVE_ANALYSIS_MAX_EVENT_AGE_SECONDS=900
# Raw cloud slices stay disabled unless both this switch and
# X-Raw-Cloud-Approved:true are present. Restricted events additionally require
# consent_scope=alpha.raw_cloud or owner_full_context. Cloud audit rows remain redacted.
MOUCHEN_ALLOW_RAW_CLOUD=false
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
# HTTPS base including the API version prefix, without a trailing endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
# responses (default) or chat_completions for compatible third-party gateways.
OPENAI_API_STYLE=responses
OPENAI_ROUTINE_MODEL=gpt-5.6-terra
OPENAI_COMPLEX_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_REVIEW_MODEL=claude-opus-5
# auto prefers local Claude Code, then Anthropic. Set openai explicitly only when
# an independent GPT critic is the intended L3 second-opinion provider.
MOUCHEN_CLAUDE_REVIEW_PROVIDER=auto
OPENAI_SECOND_OPINION_MODEL=gpt-5.6-sol
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_REVIEW_MODEL=claude-fable-5
CLAUDE_CODE_TIMEOUT_SECONDS=90
MOUCHEN_SAFETY_SALT=change-me
MOUCHEN_SAFETY_SALT_FILE=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AUTH_TOKEN=
OLLAMA_AUTH_TOKEN_FILE=

# Private audio transcription. Start the resident Mandarin Paraformer service
# on loopback for non-Compose development; Docker overrides this with `stt`.
MOUCHEN_LOCAL_STT_ENABLED=false
MOUCHEN_LOCAL_STT_SERVER_URL=http://127.0.0.1:8080/inference
MOUCHEN_LOCAL_STT_ENGINE=local-paraformer-sherpa-onnx
MOUCHEN_LOCAL_STT_FFMPEG=ffmpeg
MOUCHEN_LOCAL_STT_MODEL=../.tools/models/paraformer/model.int8.onnx
MOUCHEN_LOCAL_STT_MODEL_SHA256=f36a0433bcf096bd6d6f11b80a3ac8bed110bdca632fe0d731df8d1a84475945
MOUCHEN_LOCAL_STT_MODEL_SIZE=243371218
MOUCHEN_LOCAL_STT_TIMEOUT_SECONDS=15
MOUCHEN_LOCAL_STT_THREADS=4
MOUCHEN_LOCAL_STT_USE_GPU=false
# SQLite-durable transcription admission shared by all backend workers. Runtime
# raises a too-short lease to cover upload timeout + inference timeout + margin.
MOUCHEN_STT_RATE_WINDOW_SECONDS=300
MOUCHEN_STT_REQUESTS_PER_WINDOW=10
MOUCHEN_STT_USER_CONCURRENCY=1
MOUCHEN_STT_GLOBAL_CONCURRENCY=2
MOUCHEN_STT_LEASE_SECONDS=60
MOUCHEN_STT_BODY_READ_TIMEOUT_SECONDS=30
# Full exports are spooled under the database volume, never the 64 MiB /tmp.
MOUCHEN_ACCOUNT_EXPORT_TEMP_DIR=./data/.account-exports
MOUCHEN_ACCOUNT_EXPORT_MAX_BYTES=268435456
MOUCHEN_ACCOUNT_EXPORT_COOLDOWN_SECONDS=300
MOUCHEN_ACCOUNT_EXPORT_LEASE_SECONDS=3600
MOUCHEN_ACCOUNT_STEP_UP_ATTEMPTS_PER_WINDOW=5
MOUCHEN_ACCOUNT_STEP_UP_SOURCE_ATTEMPTS_PER_WINDOW=25
MOUCHEN_ACCOUNT_STEP_UP_WINDOW_SECONDS=900
