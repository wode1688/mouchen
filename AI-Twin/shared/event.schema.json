{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wode1688/mouchen/main/shared/event.schema.json",
  "title": "AI替身 Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "user_id", "source", "type", "occurred_at", "facts", "confidence", "sensitivity"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "user_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "type": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "facts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "content_kind": {
          "enum": [
            "chat",
            "search",
            "web_page",
            "video",
            "document",
            "system_notice",
            "app_ui",
            "user_input",
            "audio",
            "unknown"
          ]
        },
        "speaker": {
          "enum": ["user", "counterparty", "author", "system", "assistant", "unknown"]
        },
        "message_direction": {
          "enum": ["inbound", "outbound", "self", "unknown"]
        },
        "visible_only": {"type": "boolean"},
        "evidence_strength": {
          "enum": ["direct", "corroborated", "contextual", "inferred"]
        },
        "session_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{16,64}$"},
        "resolution_state": {"enum": ["unknown", "unresolved", "resolved"]}
      }
    },
    "entities": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sensitivity": {"enum": ["public", "personal", "sensitive", "restricted"]},
    "consent_scope": {"type": "string"},
    "evidence_ref": {"type": ["string", "null"]},
    "retention_until": {"type": ["string", "null"], "format": "date-time"},
    "schema_version": {"type": "integer", "minimum": 1, "default": 1}
  }
}
