# Optional cloud routes. Raw local documents must not be placed here.
OPENAI_API_KEY=
# HTTPS base including the API version prefix, without a trailing endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
# responses (default) or chat_completions for compatible third-party gateways.
OPENAI_API_STYLE=responses
OPENAI_ROUTINE_MODEL=gpt-5.6-terra
OPENAI_COMPLEX_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_REVIEW_MODEL=claude-opus-5

# L4 second opinion: auto prefers the local Claude Code CLI, then Anthropic API.
MOUCHEN_CLAUDE_REVIEW_PROVIDER=auto
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_REVIEW_MODEL=fable
CLAUDE_CODE_TIMEOUT_SECONDS=180

# Change this per deployment before serving more than a private test account.
MOUCHEN_SAFETY_SALT=change-me

# Optional user-owned private model node.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AUTH_TOKEN=

# Backend persistence.
MOUCHEN_DB_PATH=backend/data/mouchen.db
